  "craft": {
    "eyebrow": {
      "lead": "The hand",
      "items": "Cut · strung · lit"
    },
    "title": [
      "A chandelier is",
      "a thousand decisions",
      "made by hand."
    ],
    "plates": [
      {
        "id": "ca",
        "layout": "media-left",
        "label": "Cut",
        "title": [
          "Every facet is cut,",
          "then polished"
        ],
        "body": "The edge has to hold light on one side and shadow on the other. Cut too shallow and the crystal turns to glass; cut too deep and it swallows the room.",
        "image": "media/crystal/pendants.webp",
        "alt": "Cut-crystal pendants hanging from a gilt corona",
        "parallax": 0.16
      },
      {
        "id": "cb",
        "layout": "media-right",
        "label": "Strung",
        "title": [
          "Each drop is drilled,",
          "checked, then hung"
        ],
        "body": "In the order the drawing calls for. One row out of line and the whole run comes back down — there is no machine that makes that judgement.",
        "image": "media/crystal/strung.webp",
        "alt": "Rows of crystal drops strung on wire, close up",
        "parallax": 0.16
      }
    ],
    "close": {
      "label": "Lit",
      "title": [
        "It is only finished",
        "once it is lit"
      ],
      "body": "Frame, balance, switch on. In the light the piece either holds together or it does not — and that is the moment we judge the work, not the drawing.",
      "image": "media/crystal/lit.webp",
      "alt": "The 70086 fixture switched on, its flame bulbs lit",
      "parallax": 0.1,
      "cta": {
        "label": "Start an enquiry",
        "href": "#enquire"
      }
    }
